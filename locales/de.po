#: tui/labels.go:102
msgid "Starting point"
msgstr "Ausgangspunkt"

#: tui/labels.go:104
msgid "Choose where to start from. Every answer it fills in can still be changed afterwards."
msgstr "Den Ausgangspunkt wählen. Jede Antwort, die er einträgt, lässt sich danach noch ändern."

#. the first %d is how many tests passed, the second how many ran.
#: tui/labels.go:116
